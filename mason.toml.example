# A developer's mason settings for one project. Copy this file to
# ~/.config/mason/projects/<owner>/<repo>.toml, named after the project's GitHub repository, keep
# `version`, and delete every section and key you don't need to change. The settings are yours,
# not the project's: nothing is added to the project.
#
# The file is optional, and so is every key in it. A key the file leaves out is detected from the
# repository (the GitHub remote, origin/HEAD, compiled requirements headers, tracked npm
# lockfiles, an ignored .env) or defaulted. So a project only needs the file once a value has to
# differ, and then only the keys that differ. To see what a project resolves to, and where each
# value came from, as a starting file:
#   mason config <project dir> --toml
# tests/test_project.py validates this file.

# The version of this file's format. Required: a later mason that changes the format refuses an
# older file and says how to update it, rather than misreading it.
version = 1

[workflows]
# The workflows you run on this project; `mason run` refuses any other. Leave it out to allow
# every workflow. `mason project add` writes it.
enabled = ['dependency-assessment', 'dependency-upgrades', 'code-review']

[project]
# Written by `mason project archive`, and removed by `--undo`: an archived project runs nothing.
archived = '2026-11-25'

[repo]
name = 'example-org/example-app'
main_branch = 'main'

[limits]
# Open agent PRs across all workflows. A pass that would go over opens nothing new and says so.
open_agent_prs = 3
stale_after_days = 14

[verify]
# Set false only if two worktrees can run the tests at the same time. Tests that run in docker
# compose with named volumes can't: the volumes are shared between worktrees.
exclusive = true
reason = 'docker compose volumes are shared between worktrees'
# Untracked files a fresh worktree needs before verify commands can run. Copied, never linked.
worktree_copy = ['.env']
# CI runs the tests on every pull request. Detected from .circleci/config.yml or
# .github/workflows/. An unattended run that can't test locally leaves the tests to CI.
ci = true

[dependency-upgrades]
pip_requirements = ['requirements/*.txt']
pip_sources = ['requirements/*.in']
# Detected from the compiled files' headers when left out. Setting CUSTOM_COMPILE_COMMAND keeps
# the header the same whichever way the files are compiled, so it doesn't churn in the diff.
pip_compile = 'CUSTOM_COMPILE_COMMAND="make requirements" pip-compile requirements/base.in'
npm_projects = ['frontend', 'frontend/admin']
npm_build = 'npm run build'
# When left out, the skill takes the test command from the project's AGENTS.md and says so.
verify = ['make test']

[dependency-report]
# The Discussions category the monthly report is published in. Create it in the repository's
# Discussions tab first (an announcement-type category, so only maintainers can start threads).
# The report judges fix times against the targets in [dependency-retrospective].
category = 'Dependency reports'
# Where each manifest's packages end up, so the report can say how many open vulnerabilities are
# in production. Globs, matched against Dependabot's manifest paths; the first group that matches
# wins, and a manifest in none is "not classified". Take these from how the project is actually
# deployed, not from file names. Leave all four out to use Dependabot's own runtime/development
# label instead, which guesses from file names and from how each package was declared.
production = ['requirements/base.txt', 'requirements/deploy.txt']
# Installed and run on production machines to build what is served, but not served themselves.
production_build = ['frontend/package.json', 'frontend/package-lock.json']
development = ['requirements/dev.txt']
not_deployed = ['docs/**']

[dependency-retrospective]
# How far back a retrospective looks when there is no earlier one to continue from.
period_days = 30
# How fast each severity should be fixed, in days from the alert opening. Alerts open past these
# are reported, and so is the time each fixed alert actually took.
fix_within_days_critical = 3
fix_within_days_high = 7
fix_within_days_medium = 30
fix_within_days_low = 90
# A package with no release for this long is reported as possibly abandoned.
stale_after_months = 24

[code-review]
# The project's own conventions: documents in the repository, read as its rules (at the PR's
# base). Detected from docs/conventions.md or CONVENTIONS.md.
conventions = ['docs/conventions.md']
# Knowledge skills installed in the project the review also loads, e.g. framework rules.
knowledge = ['django-development']
# Findings posted as inline comments on the diff: 'none' (one consolidated comment), 'suggestions'
# (only findings with a suggested replacement, so they can be applied), or 'all'.
inline = 'none'

[code-review-retrospective]
# How far back a retrospective looks when there is no earlier one to continue from.
period_days = 30

[sentry-errors]
# Can't be detected: the Sentry organisation and project slugs. The auth token is never in this
# file: it is SENTRY_AUTH_TOKEN in the environment of whoever runs the workflow.
sentry_org = 'example-org'
sentry_project = 'example-app'
# For self-hosted Sentry, or a regional host such as https://de.sentry.io.
sentry_url = 'https://sentry.io'
# Each run triages one environment at a time, in this order.
environments = ['production', 'staging']
# How far back a run looks for unresolved errors.
period_days = 14
# Stack frames under these paths are the project's own code; the rest are libraries.
trace_path_prefixes = ['apps/', 'src/']
# Repositories a fix may belong in instead, such as infrastructure configuration.
related_repos = ['example-org/infrastructure']
verify = ['make test']
# A fix counts as working when its errors stay quiet this long after it merges.
quiet_after_days = 14

[sentry-retrospective]
period_days = 30
# Time allowed between a merge and its deploy before a new event counts against the fix.
deploy_grace_hours = 24
