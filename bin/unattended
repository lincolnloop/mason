#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""Run a workflow unattended against a project: `bin/unattended <workflow> <project>`.

The entry point for a scheduler or another agent. See lib/artifacts/unattended.py."""

import argparse
import shlex
import subprocess
import sys
from pathlib import Path

HUB = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(HUB / 'lib'))

from artifacts import unattended  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(prog='unattended', description=__doc__)
    parser.add_argument('workflow', choices=sorted(unattended.WORKFLOWS))
    parser.add_argument('project', type=Path, help='project root')
    parser.add_argument(
        '--allow',
        action='append',
        default=[],
        help='another tool the project needs, e.g. "Bash(docker *)"; repeatable',
    )
    parser.add_argument(
        '--trigger',
        default='bin/unattended',
        help='what started the run, shown on the PR, e.g. "systemd timer dependency-upgrades.timer"',
    )
    parser.add_argument('--pr', type=int, help='the pull request, for a workflow that acts on one')
    parser.add_argument('--claude', default='claude', help='the claude executable')
    parser.add_argument('--dry-run', action='store_true', help='print the command; run nothing')
    args = parser.parse_args()
    if not (args.project / '.git').exists():
        parser.error(f'{args.project} is not the root of a git repository')
    try:
        command = unattended.command(
            HUB, args.project, args.workflow, tuple(args.allow), args.claude, args.pr
        )
    except ValueError as exc:
        parser.error(str(exc))
    if args.dry_run:
        env = f'AUTOMATION_UNATTENDED=1 AUTOMATION_TRIGGER={shlex.quote(args.trigger)} UV_OFFLINE=1'
        print(f'cd {shlex.quote(str(args.project))} && {env} {shlex.join(command)}')
        return 0
    check = subprocess.run(
        unattended.doctor_command(HUB, args.workflow),
        cwd=args.project,
        env=unattended.environment(args.trigger),
        capture_output=True,
        text=True,
        check=False,
    )
    if check.returncode != 0:
        sys.stderr.write(check.stdout + check.stderr)
        print(f'{args.workflow} not started: artifact doctor failed', file=sys.stderr)
        return 1
    status, log = unattended.run(HUB, args.project, args.workflow, command, args.trigger)
    print(f'{args.workflow} finished with status {status}; log: {log}')
    return status


if __name__ == '__main__':
    sys.exit(main())
