#!/usr/bin/env python3
"""The command line the workflow skills call. Run it in this repository's locked environment:

    uv run --project <mason> --locked python -I <mason>/bin/artifact <command> ...

`-I` ignores the current directory (usually a project's) and the environment; this script adds
only this repository's own `lib/` to the path."""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'lib'))

from artifacts.cli import main  # noqa: E402

if __name__ == '__main__':
    sys.exit(main())
